# ============================================================================
# AI Revenue Agent Platform — environment variables
# Copy this file to .env and fill in real values for your environment.
# Variables follow spec section 35. Anything left blank falls back to a
# DEMO/MOCK connector — see BUILD_NOTES.md → "What's real vs. mocked".
# ============================================================================

# --- Core infrastructure (required) ----------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_revenue_agent?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth / crypto (required — generate real random values for anything
#     beyond local dev; these gate session signing and credential-at-rest
#     encryption, see src/lib/auth.ts and src/lib/crypto.ts) -----------------
JWT_SECRET="replace-with-a-long-random-string"
ENCRYPTION_KEY="replace-with-a-long-random-string"
# Signs platform-staff sessions (src/lib/platform-auth.ts) — deliberately
# a DIFFERENT secret from JWT_SECRET above, so a leaked tenant secret
# can't forge a cross-tenant admin session. Required on both the main
# site and the admin site (see ADMIN_HOSTNAME below) — same value on both.
PLATFORM_JWT_SECRET="replace-with-a-different-long-random-string"

# --- App URLs (required) ----------------------------------------------------
APP_URL="http://localhost:3000"
WIDGET_URL="http://localhost:3000/widget.js"
API_URL="http://localhost:3000/api"
# Splits the platform-admin surface (/platform/**) onto its own Netlify
# site/hostname (src/middleware.ts) — leave unset to keep /platform on
# the same host as the app (fine for local dev). Set to the SAME
# hostname value on BOTH the main site and the dedicated admin site,
# e.g. "agenticsale-admin.netlify.app" — the middleware uses this one
# value to tell which of the two deployments it's running as.
ADMIN_HOSTNAME=""

# --- Dev-only login bypass (optional, DANGEROUS — leave unset) -------------
# Set DISABLE_AUTH="true" to skip /login entirely for local demos — every
# request is treated as already authenticated as DISABLE_AUTH_EMAIL (default
# owner@raygrid.demo). Hard-gated to never activate when NODE_ENV=production
# (see src/lib/auth.ts), but it still weakens local dev security, so keep it
# unset/false unless you're actively doing a walkthrough. Never set this in
# any deployed environment's config. See BUILD_NOTES.md → "Dev-only login
# bypass" for the full writeup.
DISABLE_AUTH="false"
DISABLE_AUTH_EMAIL="owner@raygrid.demo"

# --- AI provider (optional) -------------------------------------------------
# Leave unset to use the deterministic, offline MockAIProvider (default —
# see src/modules/ai/mock-provider.ts). Set this to activate the real
# Anthropic-backed provider (src/modules/ai/anthropic-provider.ts) instead.
# Real replies cost real API tokens and are metered against the tenant's
# credit balance — see src/modules/billing/pricing.ts.
ANTHROPIC_API_KEY=""
AI_PROVIDER_API_KEY=""
# Optional override for the default (non-escalated) model — see
# src/modules/billing/model-router.ts. Leave unset to use DEFAULT_MODEL
# (currently claude-haiku-4-5) from src/modules/billing/pricing.ts.
ANTHROPIC_MODEL=""

# --- Meta (Facebook/Instagram/WhatsApp) — optional -------------------------
# Without these, advertising + WhatsApp channel integrations run against the
# labelled DEMO/MOCK connectors (src/integrations/advertising/mock-connector.ts).
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Google (Ads / OAuth) — optional ----------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# --- Object storage (optional — for uploaded knowledge-base files/assets) --
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
